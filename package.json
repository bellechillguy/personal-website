{
  "name": "my-portfolio-qwik",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build.server": "qwik check-client src dist && vite build -c adapters/vercel-edge/vite.config.ts",
    "build:dev": "vite build --mode development",
    "deploy": "vercel deploy",
    "dev": "vite --mode ssr",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "qwik": "qwik"
  },
  "dependencies": {
    "@builder.io/qwik": "latest",
    "@builder.io/qwik-city": "latest",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^2.1.1",
    "marked": "^18.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "semver": "^7.8.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vercel": "^29.1.1",
    "vite": "^7.0.0"
  }
}
